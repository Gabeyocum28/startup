# Copy to ~/stacks/polyrhythmd/.env on the server and fill in. Never commit real values.

# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster.mongodb.net/)
MONGO_URI=

# Reserved for future use. The current code does not read these: music data
# comes from the public Deezer API and sessions use random cookie tokens.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
JWT_SECRET=
